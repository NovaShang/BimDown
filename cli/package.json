{
  "name": "bimdown-cli",
  "version": "0.5.1",
  "description": "CLI for BimDown, an open plain-text BIM format (CSV + GeoJSON): validate, build, render floor plans, query with SQL, import IFC, diff and merge. Toolchain for AI agents.",
  "author": "NovaShang",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NovaShang/BimDown.git"
  },
  "homepage": "https://bim.jouledown.com",
  "bugs": {
    "url": "https://github.com/NovaShang/BimDown/issues"
  },
  "keywords": [
    "bim",
    "building-information-modeling",
    "ifc",
    "revit",
    "aec",
    "architecture",
    "floor-plan",
    "geojson",
    "csv",
    "duckdb",
    "sql",
    "cli",
    "llm",
    "ai-agents",
    "agent-skill",
    "claude-code"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "package.json"
  ],
  "type": "module",
  "bin": {
    "bimdown": "dist/cli.js"
  },
  "main": "./dist/lib.js",
  "types": "./dist/lib.d.ts",
  "exports": {
    ".": {
      "types": "./dist/lib.d.ts",
      "import": "./dist/lib.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@duckdb/node-api": "^1.5.0-r.1",
    "commander": "^13.1.0",
    "fast-xml-parser": "^5.2.0",
    "fflate": "^0.8.2",
    "jsts": "^2.12.1",
    "sharp": "^0.34.5",
    "web-ifc": "^0.0.77",
    "yaml": "^2.7.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.4.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
